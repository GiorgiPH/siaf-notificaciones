# ─── Sesión ──────────────────────────────────────────────────────────────────
# Llave para cifrar la cookie de sesión (siaf_session). Mínimo 32 caracteres,
# distinta por entorno. Generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Vigencia máxima de la sesión en segundos (espejo de app.seguridad.sesion.maximo = 12h).
# SESSION_MAX_AGE_SECONDS=43200

# ─── Backend SIAF ────────────────────────────────────────────────────────────
# Base del backend, incluye el context path. Solo servidor: nunca NEXT_PUBLIC_.
# Local: ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
API_INSTITUTIONAL_URL=http://localhost:8080/siaf
# API_TIMEOUT_MS=15000

# Nombre de la cookie del refresh token que pone el backend
# (app.seguridad.sesion.cookie.nombre): "rt" en el perfil dev, "__Secure-rt" en QA/prod.
SIAF_REFRESH_COOKIE=rt

# ─── Requisito del backend en QA/prod (no es variable de este proyecto) ──────
# El rate limit de login es por IP. Next reenvía la IP del usuario en
# X-Forwarded-For, pero el backend solo la acepta si la IP del servidor Next
# está en PROXIES_CONFIABLES. Sin eso, todos los usuarios comparten un solo
# límite (10 logins/min).
